"857d79fa-5908-41b0-be01-2a2cfd8d2fc9"}, {"key": "identifier", "value": "https://hvbg.hessen.de/registry/spatial/dataset/d1d26664-c8c5-488d-991c-1f26ca61d2b1"}, {"key": "issued", "value": "2025-04-04"}, {"key": "modified", "value": "2025-04-04"}, {"key": "publisher_email", "value": "vertrieb-geobasisdaten@hvbg.hessen.de"}, {"key": "publisher_name", "value": "Hessisches Landesamt f\u00fcr Bodenmanagement und Geoinformation"}, {"key": "publisher_uri", "value": "https://www.geoportal.hessen.de/organization/b784a7b4-e7fa-4938-8075-ca4b877eced8"}, {"key": "spatial", "value": "{\"type\": \"Polygon\", \"coordinates\": [[[7.7724667, 49.3952723], [10.2364142, 49.3952723], [10.2364142, 51.6577889], [7.7724667, 51.6577889], [7.7724667, 49.3952723]]]}"}, {"key": "temporal_end", "value": "2023-07-25T00:00:00.000+02:00"}, {"key": "temporal_start", "value": "2022-07-01T00:00:00.000+02:00"}, {"key": "theme", "value": "[\"http://publications.europa.eu/resource/authority/data-theme/JUST\", \"http://publications.europa.eu/resource/authority/data-theme/ECON\", \"http://publications.europa.eu/resource/authority/data-theme/GOVE\"]"}, {"key": "uri", "value": "https://www.geoportal.hessen.de/dataset/d1d26664-c8c5-488d-991c-1f26ca61d2b1"}, {"key": "harvest_source_title", "value": "Hessisches Landesamt f\u00fcr Bodenmanagement und Geoinformation"}], "groups": [{"description": "Daten zu Anschriften", "display_name": "Adresse", "id": "9b480281-c16d-4c67-bdbf-0fddb49b6b14", "image_display_url": "", "name": "adresse", "title": "Adresse"}, {"description": "Daten zu den Nummern der einzelnen H\u00e4user", "display_name": "Hausnummer", "id": "7f0cde31-7ad8-4886-bcc5-ef5325ae73fb", "image_display_url": "", "name": "hausnummer", "title": "Hausnummer"}, {"description": "", "display_name": "Hessen", "id": "e605470a-5691-492c-8979-4ea645cc49c5", "image_display_url": "", "name": "hessen", "title": "Hessen"}, {"description": "Datensatzthema, das die Bereiche Justiz, Rechtssystem und \u00f6ffentliche Sicherheit abdeckt, wobei \u201eJustiz\u201c die Grunds\u00e4tze des fairen Verfahrens bei der Rechtsanwendung bezeichnet, \u201eRechtssystem\u201c verschiedene Rechtsrahmen wie Civil Law, Common Law, Gesetzesrecht und religi\u00f6ses Recht umfasst und \u201e\u00f6ffentliche Sicherheit\u201c die Verantwortung des Staates f\u00fcr den Schutz von Personen, Organisationen und Einrichtungen vor Bedrohungen ihres Wohlergehens und des Wohlstandes von Gemeinschaften bezeichnet", "display_name": "Justiz, Rechtssystem und \u00f6ffentliche Sicherheit", "id": "e2d9e3b8-2e2c-4ab4-b2d4-867b4539157b", "image_display_url": "", "name": "justiz-rechtssystem-und-offentliche-sicherheit", "title": "Justiz, Rechtssystem und \u00f6ffentliche Sicherheit"}, {"description": "Datensatzthema f\u00fcr die Bereiche Regierung und \u00f6ffentlicher Sektor, wobei die Regierung das System oder die Gruppe von Personen darstellt, die eine organisierte Gemeinschaft, normalerweise einen Staat, f\u00fchren, w\u00e4hrend der \u00f6ffentliche Sektor das Wirtschaftssegment der \u00f6ffentlichen Dienste und Unternehmen umfasst, die von zentralstaatlichen, regionalen oder lokalen Beh\u00f6rden verwaltet werden k\u00f6nnen", "display_name": "Regierung und \u00f6ffentlicher Sektor", "id": "b739013c-1f67-4a6a-82d0-6b894f64e0d7", "image_display_url": "", "name": "regierung-und-offentlicher-sektor", "title": "Regierung und \u00f6ffentlicher Sektor"}, {"description": "Datensatzthema f\u00fcr die Bereiche Wirtschaftst\u00e4tigkeiten, worunter die Herstellung und Verteilung von Waren und Dienstleistungen sowie der Handel mit ihnen und ihr Verbrauch bzw. ihre Inanspruchnahme fallen, und finanzielle T\u00e4tigkeiten, die schwerpunktm\u00e4\u00dfig der Verwaltung von Geld auf individueller, betrieblicher oder staatlicher Ebene gelten", "display_name": "Wirtschaft und Finanzen", "id": "54917440-dd7c-45d6-83a7-f03099534059", "image_display_url": "", "name": "wirtschaft-und-finanzen", "title": "Wirtschaft und Finanzen"}], "res